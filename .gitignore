# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Docker: files copied out of images (e.g. scripts/docker_linux_extract.sh)
docker-artifacts/

# Linux desktop: symlinks recreated by flutter pub get; point at machine-specific pub-cache
linux/flutter/ephemeral/.plugin_symlinks/

# Local secrets / env (do not commit)
.env
.env.local
.env.*.local

# Local scratch
build_log.txt

# Stray installers at repo root (packages normally under build/ or docker-artifacts/)
/*.deb

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio / Gradle build artifacts (avoid pushing large APKs and build outputs)
/android/app/build/
/android/build/
build/app-release.apk
*.apk
*.aab
*.ap_
*.dex

