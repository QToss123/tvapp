# -------------------------------------------------------
# Flutter Linux Desktop Builder
# Build Linux release bundle from any host (Mac/Windows)
# -------------------------------------------------------

    FROM ubuntu:22.04

    ENV DEBIAN_FRONTEND=noninteractive
    ENV FLUTTER_HOME=/opt/flutter
    ENV PATH=$FLUTTER_HOME/bin:$PATH
    
    # -------------------------------------------------------
    # System dependencies (build + webview support)
    # -------------------------------------------------------
    RUN apt-get update && apt-get install -y --no-install-recommends \
        clang \
        cmake \
        ninja-build \
        pkg-config \
        libgtk-3-dev \
        liblzma-dev \
        libstdc++-12-dev \
        libwebkit2gtk-4.1-dev \
        wget \
        git \
        curl \
        ca-certificates \
        xz-utils \
        unzip \
        && rm -rf /var/lib/apt/lists/*
    
    # -------------------------------------------------------
    # Install Flutter SDK
    # -------------------------------------------------------
    ARG FLUTTER_ZIP_URL=https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.24.5-stable.tar.xz
    
    RUN wget -q -O flutter.tar.xz ${FLUTTER_ZIP_URL} && \
        tar -xJf flutter.tar.xz -C /opt && \
        rm flutter.tar.xz
    
# -------------------------------------------------------
# Flutter configuration (fix git "dubious ownership" when running as root)
# -------------------------------------------------------
RUN git config --global --add safe.directory /opt/flutter && \
    flutter config --enable-linux-desktop && \
    flutter config --no-analytics && \
    flutter doctor -v
    
    # -------------------------------------------------------
    # Working directory
    # -------------------------------------------------------
    WORKDIR /app
    
    # Copy only pubspec first (for cache optimization)
    COPY pubspec.* ./
    RUN flutter pub get
    
    # Copy full project
    COPY . .
    
    # -------------------------------------------------------
    # Build Linux release
    # -------------------------------------------------------
    RUN flutter build linux --release
    
    # -------------------------------------------------------
    # Export build to mounted volume (/out)
    # -------------------------------------------------------
    CMD ["/bin/sh", "-c", "mkdir -p /out && cp -r build/linux/x64/release/bundle /out/ && echo '======================================' && echo 'Linux build exported to ./output/bundle' && echo '======================================'"]