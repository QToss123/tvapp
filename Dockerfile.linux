# syntax=docker/dockerfile:1.4
# Pass target platform at build time when needed, e.g. ARM hosts: docker build --platform linux/amd64 ...
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 1. Install dependencies + fix /lib64 linker for QEMU amd64 emulation on ARM hosts
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang cmake ninja-build pkg-config \
    libgtk-3-dev liblzma-dev libstdc++-12-dev libwebkit2gtk-4.1-dev \
    llvm-14 lld-14 \
    wget git curl ca-certificates xz-utils unzip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /lib64 \
    && ln -sf /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2 2>/dev/null || true

# 2. Install Flutter (stable)
ENV FLUTTER_HOME=/opt/flutter
ENV PATH=$FLUTTER_HOME/bin:$PATH

RUN git clone https://github.com/flutter/flutter.git -b stable $FLUTTER_HOME

# 3. Pre-cache Flutter Linux desktop artifacts
RUN flutter precache --linux --no-web --force

# 4. Flutter setup
RUN git config --global --add safe.directory /opt/flutter && \
    flutter config --enable-linux-desktop && \
    flutter config --no-analytics && \
    (flutter doctor -v || true)

# 5. App build
WORKDIR /app

COPY pubspec.* ./
RUN flutter pub get

COPY . .

# Host copies may include .plugin_symlinks pointing at absolute host paths; remove so pub get
# recreates symlinks inside this image (see linux/flutter/ephemeral/.plugin_symlinks).
RUN rm -rf linux/flutter/ephemeral/.plugin_symlinks && flutter pub get

# Dev or Prod — controls artifact names: app-release_${BUILD_ENV}.deb and linux-bundle_${BUILD_ENV}/
# Dart defines still use underscore prefix (e.g. _Dev, _Prod) for PACKAGE_SUFFIX compatibility.
ARG BUILD_ENV=Dev
ARG BACKEND_URL=

# BOOK_KEY via BuildKit secret (not ARG) — avoids storing credentials in image build history.
# Omit --secret for an empty key, or use:
#   --secret id=book_key,env=MY_VAR
#   --secret id=book_key,src=./path/to/keyfile
RUN --mount=type=secret,id=book_key,required=false \
    BK="$(cat /run/secrets/book_key 2>/dev/null || true)" && \
    flutter build linux --release \
      --dart-define=BACKEND_URL="${BACKEND_URL}" \
      --dart-define=BOOK_KEY="$BK" \
      --dart-define=PACKAGE_SUFFIX=_${BUILD_ENV} \
      --dart-define=BUILD_ENV=${BUILD_ENV}

# 6. Package as .deb and copy to /artifacts (uses BUILD_ENV from above)
ARG APP_NAME=tv-app-books
ARG APP_VERSION=1.0.0

RUN DEB_DIR=/tmp/${APP_NAME}_${APP_VERSION}_amd64 && \
    mkdir -p ${DEB_DIR}/opt/${APP_NAME} && \
    mkdir -p ${DEB_DIR}/usr/share/applications && \
    mkdir -p ${DEB_DIR}/DEBIAN && \
    cp -a build/linux/x64/release/bundle/* ${DEB_DIR}/opt/${APP_NAME}/ && \
    printf 'Package: %s\nVersion: %s\nSection: utils\nPriority: optional\nArchitecture: amd64\nDepends: libgtk-3-0, libwebkit2gtk-4.1-0\nMaintainer: Liqvid <dev@liqvid.com>\nDescription: BurlingtonEnglish Bookshelf App\n' \
      "${APP_NAME}" "${APP_VERSION}" > ${DEB_DIR}/DEBIAN/control && \
    printf '[Desktop Entry]\nName=BurlingtonEnglish\nExec=/opt/%s/tv_app_books\nType=Application\nCategories=Education;\n' \
      "${APP_NAME}" > ${DEB_DIR}/usr/share/applications/${APP_NAME}.desktop && \
    dpkg-deb --build ${DEB_DIR} && \
    mkdir -p /artifacts && \
    cp ${DEB_DIR}.deb "/artifacts/app-release_${BUILD_ENV}.deb" && \
    cp -a build/linux/x64/release/bundle "/artifacts/linux-bundle_${BUILD_ENV}"
