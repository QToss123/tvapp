FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV FLUTTER_HOME=/opt/flutter
ENV PATH=$FLUTTER_HOME/bin:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools:$PATH

# -------------------------------------------------------
# System dependencies
# -------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk \
    wget \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    clang \
    cmake \
    ninja-build \
    libgtk-3-dev \
    libstdc++-12-dev \
    && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------
# Install Android SDK
# -------------------------------------------------------
RUN mkdir -p $ANDROID_SDK_ROOT/cmdline-tools

WORKDIR /opt

RUN wget https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \
    unzip commandlinetools-linux-11076708_latest.zip -d $ANDROID_SDK_ROOT/cmdline-tools && \
    mv $ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools $ANDROID_SDK_ROOT/cmdline-tools/latest && \
    rm commandlinetools-linux-11076708_latest.zip

# Accept licenses + install SDK components
RUN yes | sdkmanager --licenses

RUN sdkmanager \
    "platform-tools" \
    "platforms;android-34" \
    "build-tools;34.0.0"

# -------------------------------------------------------
# Install Flutter
# -------------------------------------------------------
RUN git clone https://github.com/flutter/flutter.git -b stable $FLUTTER_HOME
RUN git config --global --add safe.directory $FLUTTER_HOME

RUN flutter config --no-analytics
RUN flutter doctor -v

# -------------------------------------------------------
# App build
# -------------------------------------------------------
WORKDIR /app

COPY pubspec.* ./
RUN flutter pub get

COPY . .

RUN flutter build apk --release

# -------------------------------------------------------
# Export APK
# -------------------------------------------------------
CMD mkdir -p /out && \
    cp build/app/outputs/flutter-apk/app-release.apk /out/ && \
    echo "APK exported to output folder"