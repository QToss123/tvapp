# Linux container: Flutter + Android SDK → release APK under /artifacts (for GitLab CI extract).
# Local: docker build -f Dockerfile.android -t tv-books-apk \
#   --build-arg BACKEND_URL=https://example.com/ --build-arg BOOK_KEY=key --build-arg PACKAGE_SUFFIX=_Dev .
#
# Flutter must match pubspec (Dart >=3.10 / Flutter >=3.35). Override: --build-arg FLUTTER_VERSION=3.35.4

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk \
    unzip \
    xz-utils \
    wget \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG ANDROID_SDK_VERSION=11076708
ARG ANDROID_SDK_URL=https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_SDK_VERSION}_latest.zip
ENV ANDROID_HOME=/opt/android-sdk
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q -O /tmp/cmdline-tools.zip ${ANDROID_SDK_URL} && \
    unzip -q -o /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

RUN yes | sdkmanager --licenses 2>/dev/null || true && \
    sdkmanager "platform-tools" \
    "platforms;android-35" \
    "build-tools;35.0.0" \
    && rm -rf ${ANDROID_HOME}/.android/cache

ARG FLUTTER_VERSION=3.35.4
ARG FLUTTER_ZIP_URL=https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz
ENV FLUTTER_ZIP_URL=${FLUTTER_ZIP_URL}

ARG BACKEND_URL=
ARG BOOK_KEY=
ARG PACKAGE_SUFFIX=
ENV BACKEND_URL=${BACKEND_URL}
ENV BOOK_KEY=${BOOK_KEY}
ENV PACKAGE_SUFFIX=${PACKAGE_SUFFIX}

RUN wget -q -O /tmp/flutter.tar.xz ${FLUTTER_ZIP_URL} && \
    tar -xJf /tmp/flutter.tar.xz -C /opt && \
    rm /tmp/flutter.tar.xz
ENV PATH="/opt/flutter/bin:${PATH}"

RUN git config --global --add safe.directory /opt/flutter && \
    flutter config --no-analytics && \
    flutter doctor -v || true

WORKDIR /app

COPY . .

RUN flutter pub get && \
    flutter build apk --release \
      --dart-define=BACKEND_URL=${BACKEND_URL} \
      --dart-define=BOOK_KEY=${BOOK_KEY} \
      --dart-define=PACKAGE_SUFFIX=${PACKAGE_SUFFIX}

# GitLab / generic CI: copy release APK to a fixed path inside the image
RUN mkdir -p /artifacts && \
    cp -v build/app/outputs/flutter-apk/app-release.apk /artifacts/app-release.apk && \
    ls -la /artifacts/

CMD ["sh", "-c", "echo 'APK: /artifacts/app-release.apk' && ls -la /artifacts/"]
