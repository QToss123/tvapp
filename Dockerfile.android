FROM ubuntu:24.04

USER root

# 1. Install System Dependencies
RUN apt-get update && apt-get install -y \
    curl git unzip xz-utils libglu1-mesa openjdk-17-jdk wget file \
    && rm -rf /var/lib/apt/lists/*

# 2. Define Clean Paths
ENV ANDROID_HOME=/opt/android-sdk
ENV FLUTTER_HOME=/opt/flutter
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${FLUTTER_HOME}/bin:${PATH}"

# 3. Install Android SDK (Native ARM64 Tools)
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    curl -L https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o /tmp/sdk.zip && \
    unzip -q /tmp/sdk.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm /tmp/sdk.zip

# 4. Install Flutter from Scratch
RUN git clone https://github.com/flutter/flutter.git -b stable ${FLUTTER_HOME}
RUN git config --global --add safe.directory ${FLUTTER_HOME}

# 5. Accept Licenses and install Platforms
RUN yes | sdkmanager --licenses && \
    sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

# 6. 🔥 THE FIX: Force download of ARM64 Engine
RUN flutter config --no-analytics && \
    # This downloads the 'linux-arm64' version of gen_snapshot
    flutter precache --android --linux --force --universal && \
    flutter doctor -v

# 7. App Setup
ARG BACKEND_URL
ARG BOOK_KEY
ARG PACKAGE_SUFFIX

WORKDIR /app
COPY pubspec.* ./
RUN flutter pub get
COPY . .

# 8. Build with Java 17 Toolchain
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.java.installations.paths=$JAVA_HOME"

RUN flutter build apk --release \
      --target-platform android-arm64 \
      --dart-define=BACKEND_URL=${BACKEND_URL} \
      --dart-define=BOOK_KEY=${BOOK_KEY} \
      --dart-define=PACKAGE_SUFFIX=${PACKAGE_SUFFIX}