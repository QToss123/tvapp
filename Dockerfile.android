# Linux container to download Flutter dependencies and build Android APK.
# Requires: Docker with Linux containers.
# Build: docker build -f Dockerfile.apk -t tv-app-books-apk .
# Run (build and copy out): docker run --rm -v $(pwd):/app -v $(pwd)/output:/out tv-app-books-apk
# APK output: build/app/outputs/flutter-apk/app-release.apk

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# OpenJDK 17 (required for Android Gradle)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk \
    unzip \
    xz-utils \
    wget \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Android SDK (command-line tools)
ARG ANDROID_SDK_VERSION=11076708
ARG ANDROID_SDK_URL=https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_SDK_VERSION}_latest.zip
ENV ANDROID_HOME=/opt/android-sdk
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q -O /tmp/cmdline-tools.zip ${ANDROID_SDK_URL} && \
    unzip -q -o /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

# Android SDK components (platforms, build-tools)
RUN yes | sdkmanager --licenses 2>/dev/null || true && \
    sdkmanager "platform-tools" \
    "platforms;android-34" \
    "build-tools;34.0.0" \
    && rm -rf ${ANDROID_HOME}/.android/cache

# Flutter SDK (stable Linux zip). Override: docker build --build-arg FLUTTER_ZIP_URL=...
ARG FLUTTER_ZIP_URL=https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.24.5-stable.tar.xz
ENV FLUTTER_ZIP_URL=${FLUTTER_ZIP_URL}
ARG BACKEND_URL
ARG BOOK_KEY
ARG PACKAGE_SUFFIX
ENV BACKEND_URL=${BACKEND_URL}
ENV BOOK_KEY=${BOOK_KEY}
ENV PACKAGE_SUFFIX=${PACKAGE_SUFFIX}
RUN wget -q -O /tmp/flutter.tar.xz ${FLUTTER_ZIP_URL} && \
    tar -xJf /tmp/flutter.tar.xz -C /opt && \
    rm /tmp/flutter.tar.xz
ENV PATH="/opt/flutter/bin:${PATH}"

# Flutter config and doctor (Android only)
RUN flutter config --no-analytics && \
    flutter doctor

# App lives here at build time
WORKDIR /app

# Copy project (use .dockerignore to exclude build/ and .dart_tool/)
COPY . .

# Download dependencies and build release APK
RUN flutter pub get && \
    flutter build apk --release \
      --dart-define=BACKEND_URL=${BACKEND_URL} \
      --dart-define=BOOK_KEY=${BOOK_KEY} \
      --dart-define=PACKAGE_SUFFIX=${PACKAGE_SUFFIX}

# Default: show build output location
CMD ["sh", "-c", "echo 'Build complete. APK: build/app/outputs/flutter-apk/app-release.apk' && ls -la build/app/outputs/flutter-apk/"]
