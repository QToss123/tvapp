# escape=`
# Requires: Docker with Windows containers on a Windows host (cannot build on Mac/Linux).
# Build: docker build -f Dockerfile.windows -t app-windows --build-arg BACKEND_URL=... --build-arg BOOK_KEY=... --build-arg BUILD_ENV=Dev .

FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["powershell.exe", "-ExecutionPolicy", "Bypass", "-Command"]

# 1. Visual Studio Build Tools (required for Flutter Windows desktop)
# Use the same install root as Microsoft’s container docs; a short path like C:\BuildTools often leaves
# VC\Auxiliary\Build\vcvars64.bat missing while the workload reports success.
#
# This step routinely takes 30–90+ minutes: --quiet hides installer UI/log; we poll the process and print a line every 2 min.
# Under-provisioned hosts can appear to hang or fail; raise Docker/host memory (Windows builds often ignore docker build -m).
# Use normal PowerShell $vars here; Windows docker build does not strip `$$` to `$` like Linux-oriented docs describe.
ARG CHANNEL_URL=https://aka.ms/vs/17/release/channel
ADD ${CHANNEL_URL} "C:\TEMP\VisualStudio.chman"
ADD https://aka.ms/vs/17/release/vs_buildtools.exe "C:\TEMP\vs_buildtools.exe"
RUN $installPath = 'C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools'; `
    $psi = New-Object System.Diagnostics.ProcessStartInfo; `
    $psi.FileName = 'C:\TEMP\vs_buildtools.exe'; `
    $psi.UseShellExecute = $false; `
    $psi.Arguments = '--quiet --wait --norestart --nocache --channelUri C:\TEMP\VisualStudio.chman --installChannelUri C:\TEMP\VisualStudio.chman --add Microsoft.VisualStudio.Workload.VCTools --add Microsoft.VisualStudio.Component.VC.Tools.x86.x64 --includeRecommended --installPath "' + $installPath + '"'; `
    $proc = New-Object System.Diagnostics.Process; `
    $proc.StartInfo = $psi; `
    Write-Host 'Installing Visual Studio Build Tools (VCTools). Heartbeat every 2 min until vs_buildtools.exe exits.'; `
    $started = Get-Date; `
    [void]$proc.Start(); `
    while (-not $proc.HasExited) { `
        Start-Sleep -Seconds 120; `
        try { $proc.Refresh() } catch { }; `
        $min = [int](((Get-Date) - $started).TotalMinutes); `
        Write-Host ('[vs_buildtools] still running (~' + $min + ' min since start, PID ' + $proc.Id + ')') `
    }; `
    $proc.WaitForExit(); `
    $exit = $proc.ExitCode; `
    Write-Host ('vs_buildtools.exe exited with code ' + $exit); `
    if ($exit -ne 0 -and $exit -ne 3010) { throw ('vs_buildtools.exe failed with exit ' + $exit) }; `
    $devCmd = Join-Path $installPath 'Common7\Tools\VsDevCmd.bat'; `
    if (-not (Test-Path -LiteralPath $devCmd)) { throw "VS install reported success but missing: $devCmd" }; `
    Write-Host 'Verified VsDevCmd.bat present.'

# 2. Git (needed by Flutter)
RUN Invoke-WebRequest -Uri 'https://github.com/git-for-windows/git/releases/download/v2.47.0.windows.1/Git-2.47.0-64-bit.exe' -OutFile C:\TEMP\git.exe -UseBasicParsing; `
    Start-Process -FilePath 'C:\TEMP\git.exe' -ArgumentList '/VERYSILENT /NORESTART' -Wait; `
    Remove-Item C:\TEMP\git.exe -Force

# 3. Install Flutter (stable via git clone for latest version)
RUN git clone https://github.com/flutter/flutter.git -b stable C:\flutter

# PATH: ${PATH} is unreliable in Windows Dockerfiles (can be empty), which breaks child processes (0x2).
ENV PATH="C:\\flutter\\bin;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\bin;C:\\Windows\\system32;C:\\Windows;C:\\Windows\\System32\\Wbem;C:\\Windows\\System32\\WindowsPowerShell\\v1.0"

# 4. Flutter setup (use flutter.bat explicitly; ensures correct resolution in minimal PATH scenarios)
RUN $ErrorActionPreference = 'Stop'; `
    if (-not (Test-Path 'C:\flutter\bin\flutter.bat')) { throw 'flutter.bat missing' }; `
    & 'C:\flutter\bin\flutter.bat' config --no-analytics; `
    & 'C:\flutter\bin\flutter.bat' config --enable-windows-desktop; `
    & 'C:\flutter\bin\flutter.bat' doctor -v 2>&1 | Write-Host

# 5. Cleanup installers
RUN Remove-Item -LiteralPath C:\TEMP -Recurse -Force -ErrorAction SilentlyContinue

# 6. App build
WORKDIR C:\app

COPY pubspec.* ./
RUN flutter pub get

COPY . .

# Same build-args as Dockerfile.linux / Dockerfile.android (pass from CI).
ARG BUILD_ENV=Dev
ARG BACKEND_URL=
ARG BOOK_KEY=

ENV BACKEND_URL=${BACKEND_URL}
ENV BOOK_KEY=${BOOK_KEY}
ENV BUILD_ENV=${BUILD_ENV}
ENV PACKAGE_SUFFIX=_${BUILD_ENV}

# One-line cmd /S /C often breaks on paths containing (x86): "The system cannot find the path specified".
# Emit a small .cmd file (call + quoted path works reliably) and resolve install root via vswhere when present.
RUN $ErrorActionPreference = 'Stop'; `
    $pf86 = [Environment]::GetEnvironmentVariable('ProgramFiles(x86)'); `
    $vswhere = Join-Path $pf86 'Microsoft Visual Studio\Installer\vswhere.exe'; `
    $vsRoot = $null; `
    if (Test-Path -LiteralPath $vswhere) { `
        $vsRoot = & $vswhere -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath 2>$null | Select-Object -First 1; `
        if ($vsRoot) { $vsRoot = $vsRoot.Trim() } `
    }; `
    if ([string]::IsNullOrWhiteSpace($vsRoot)) { $vsRoot = Join-Path $pf86 'Microsoft Visual Studio\2022\BuildTools' }; `
    $devCmd = Join-Path $vsRoot 'Common7\Tools\VsDevCmd.bat'; `
    $vcvars = Join-Path $vsRoot 'VC\Auxiliary\Build\vcvars64.bat'; `
    if (Test-Path -LiteralPath $devCmd) { `
        $callLine = 'call "' + $devCmd.Replace('"', '""') + '" -arch=amd64 -host_arch=amd64' `
    } elseif (Test-Path -LiteralPath $vcvars) { `
        $callLine = 'call "' + $vcvars.Replace('"', '""') + '"' `
    } else { `
        throw "Neither VsDevCmd.bat nor VC\Auxiliary\Build\vcvars64.bat under $vsRoot" `
    }; `
    $script = @('@echo off', $callLine, 'set "PATH=C:\flutter\bin;C:\Program Files\Git\cmd;C:\Program Files\Git\bin;%PATH%"', 'cd /d C:\app', 'flutter build windows --release --dart-define=BACKEND_URL=%BACKEND_URL% --dart-define=BOOK_KEY=%BOOK_KEY% --dart-define=PACKAGE_SUFFIX=%PACKAGE_SUFFIX% --dart-define=BUILD_ENV=%BUILD_ENV%') -join "`r`n"; `
    Set-Content -LiteralPath C:\build-flutter.cmd -Value $script -Encoding Oem; `
    & cmd.exe /c 'C:\build-flutter.cmd'; `
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# 7. Copy build to C:\artifacts (aligned folder name with linux-bundle_${BUILD_ENV})
RUN New-Item -ItemType Directory -Force -Path C:\artifacts | Out-Null; `
    $outDir = 'C:\artifacts\windows-release_' + $env:BUILD_ENV; `
    Copy-Item -Recurse -Force C:\app\build\windows\x64\runner\Release $outDir
