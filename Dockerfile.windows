# escape=`
# Requires: Docker with Windows containers on a Windows host (cannot build on Mac/Linux).
# Build: docker build -f Dockerfile.windows -t app-windows --build-arg BACKEND_URL=... --build-arg BOOK_KEY=... --build-arg PACKAGE_SUFFIX=_Dev .

FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["powershell.exe", "-ExecutionPolicy", "Bypass", "-Command"]

# 1. Visual Studio Build Tools (required for Flutter Windows desktop)
# Use the same install root as Microsoft’s container docs; a short path like C:\BuildTools often leaves
# VC\Auxiliary\Build\vcvars64.bat missing while the workload reports success.
#
# This step routinely takes 30–90+ minutes: the bootstrapper runs with --quiet, so Docker logs look idle.
# Under-provisioned hosts can appear to hang or fail; raise Docker/host memory (Windows builds often ignore docker build -m).
# Use normal PowerShell $vars here; Windows docker build does not strip `$$` to `$` like Linux-oriented docs describe.
ARG CHANNEL_URL=https://aka.ms/vs/17/release/channel
ADD ${CHANNEL_URL} "C:\TEMP\VisualStudio.chman"
ADD https://aka.ms/vs/17/release/vs_buildtools.exe "C:\TEMP\vs_buildtools.exe"
RUN Write-Host 'Installing Visual Studio Build Tools (VCTools). Expect 30-90+ min; --quiet produces almost no log output until finished.'; `
    $installPath = 'C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools'; `
    $vsArgs = @( `
        '--quiet', '--wait', '--norestart', '--nocache', `
        '--channelUri', 'C:\TEMP\VisualStudio.chman', `
        '--installChannelUri', 'C:\TEMP\VisualStudio.chman', `
        '--add', 'Microsoft.VisualStudio.Workload.VCTools', `
        '--add', 'Microsoft.VisualStudio.Component.VC.Tools.x86.x64', `
        '--includeRecommended', `
        '--installPath', $installPath); `
    $p = Start-Process -FilePath 'C:\TEMP\vs_buildtools.exe' -ArgumentList $vsArgs -Wait -PassThru; `
    if (-not $p) { throw 'Start-Process did not return a process handle for vs_buildtools.exe' }; `
    Write-Host ('vs_buildtools.exe exited with code ' + $p.ExitCode); `
    if ($p.ExitCode -ne 0 -and $p.ExitCode -ne 3010) { throw ('vs_buildtools.exe failed with exit ' + $p.ExitCode) }

# 2. Git (needed by Flutter)
RUN Invoke-WebRequest -Uri 'https://github.com/git-for-windows/git/releases/download/v2.47.0.windows.1/Git-2.47.0-64-bit.exe' -OutFile C:\TEMP\git.exe -UseBasicParsing; `
    Start-Process -FilePath 'C:\TEMP\git.exe' -ArgumentList '/VERYSILENT /NORESTART' -Wait; `
    Remove-Item C:\TEMP\git.exe -Force

# 3. Install Flutter (stable via git clone for latest version)
RUN git clone https://github.com/flutter/flutter.git -b stable C:\flutter

# PATH: ${PATH} is unreliable in Windows Dockerfiles (can be empty), which breaks child processes (0x2).
ENV PATH="C:\\flutter\\bin;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\bin;C:\\Windows\\system32;C:\\Windows;C:\\Windows\\System32\\Wbem;C:\\Windows\\System32\\WindowsPowerShell\\v1.0"

# 4. Flutter setup (use flutter.bat explicitly; ensures correct resolution in minimal PATH scenarios)
RUN $ErrorActionPreference = 'Stop'; `
    if (-not (Test-Path 'C:\flutter\bin\flutter.bat')) { throw 'flutter.bat missing' }; `
    & 'C:\flutter\bin\flutter.bat' config --no-analytics; `
    & 'C:\flutter\bin\flutter.bat' config --enable-windows-desktop; `
    & 'C:\flutter\bin\flutter.bat' doctor -v 2>&1 | Write-Host

# 5. Cleanup installers
RUN Remove-Item -LiteralPath C:\TEMP -Recurse -Force -ErrorAction SilentlyContinue

# 6. App build
WORKDIR C:\app

COPY pubspec.* ./
RUN flutter pub get

COPY . .

ARG BACKEND_URL
ARG BOOK_KEY
ARG PACKAGE_SUFFIX

# Flutter needs MSVC/CMake/ninja on PATH; VsDevCmd sets them for this cmd session (same install root as above).
SHELL ["cmd", "/S", "/C"]
RUN call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\Tools\VsDevCmd.bat" -arch=amd64 -host_arch=amd64 && `
    set "PATH=C:\flutter\bin;C:\Program Files\Git\cmd;C:\Program Files\Git\bin;%PATH%" && `
    cd /d C:\app && `
    flutter build windows --release `
    --dart-define=BACKEND_URL=%BACKEND_URL% `
    --dart-define=BOOK_KEY=%BOOK_KEY% `
    --dart-define=PACKAGE_SUFFIX=%PACKAGE_SUFFIX%

SHELL ["powershell.exe", "-ExecutionPolicy", "Bypass", "-Command"]

# Persist suffix for next step (ARG is not reliably exposed as $env: in all Windows Docker builds)
ENV PACKAGE_SUFFIX=${PACKAGE_SUFFIX}

# 7. Copy build to C:\artifacts with suffix in name
RUN New-Item -ItemType Directory -Force -Path C:\artifacts | Out-Null; `
    Copy-Item -Recurse -Force C:\app\build\windows\x64\runner\Release C:\artifacts\windows-release$env:PACKAGE_SUFFIX
