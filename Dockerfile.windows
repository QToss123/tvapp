# escape=`
# Requires: Docker with Windows containers on a Windows host (cannot build on Mac/Linux).
# Build: docker build -f Dockerfile.windows -t app-windows --build-arg BACKEND_URL=... --build-arg BOOK_KEY=... --build-arg PACKAGE_SUFFIX=_Dev .

FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["powershell.exe", "-ExecutionPolicy", "Bypass", "-Command"]

# 1. Visual Studio Build Tools (required for Flutter Windows desktop)
ARG CHANNEL_URL=https://aka.ms/vs/17/release/channel
ADD ${CHANNEL_URL} "C:\TEMP\VisualStudio.chman"
ADD https://aka.ms/vs/17/release/vs_buildtools.exe "C:\TEMP\vs_buildtools.exe"
RUN C:\TEMP\vs_buildtools.exe --quiet --wait --norestart --nocache `
    --channelUri C:\TEMP\VisualStudio.chman `
    --installChannelUri C:\TEMP\VisualStudio.chman `
    --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended `
    --installPath C:\BuildTools

# 2. Git (needed by Flutter)
RUN Invoke-WebRequest -Uri 'https://github.com/git-for-windows/git/releases/download/v2.47.0.windows.1/Git-2.47.0-64-bit.exe' -OutFile C:\TEMP\git.exe -UseBasicParsing; `
    Start-Process -FilePath 'C:\TEMP\git.exe' -ArgumentList '/VERYSILENT /NORESTART' -Wait; `
    Remove-Item C:\TEMP\git.exe -Force

# 3. Install Flutter (stable via git clone for latest version)
RUN git clone https://github.com/flutter/flutter.git -b stable C:\flutter

# PATH: ${PATH} is unreliable in Windows Dockerfiles (can be empty), which breaks child processes (0x2).
ENV PATH="C:\\flutter\\bin;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\bin;C:\\Windows\\system32;C:\\Windows;C:\\Windows\\System32\\Wbem;C:\\Windows\\System32\\WindowsPowerShell\\v1.0"

# 4. Flutter setup (use flutter.bat explicitly; ensures correct resolution in minimal PATH scenarios)
RUN $ErrorActionPreference = 'Stop'; `
    if (-not (Test-Path 'C:\flutter\bin\flutter.bat')) { throw 'flutter.bat missing' }; `
    & 'C:\flutter\bin\flutter.bat' config --no-analytics; `
    & 'C:\flutter\bin\flutter.bat' doctor -v 2>&1 | Write-Host

# 5. Cleanup installers
RUN Remove-Item -LiteralPath C:\TEMP -Recurse -Force -ErrorAction SilentlyContinue

# 6. App build
WORKDIR C:\app

COPY pubspec.* ./
RUN flutter pub get

COPY . .

ARG BACKEND_URL
ARG BOOK_KEY
ARG PACKAGE_SUFFIX

RUN flutter build windows --release `
    --dart-define=BACKEND_URL=$env:BACKEND_URL `
    --dart-define=BOOK_KEY=$env:BOOK_KEY `
    --dart-define=PACKAGE_SUFFIX=$env:PACKAGE_SUFFIX

# 7. Copy build to C:\artifacts with suffix in name
RUN New-Item -ItemType Directory -Force -Path C:\artifacts | Out-Null; `
    Copy-Item -Recurse -Force C:\app\build\windows\x64\runner\Release C:\artifacts\windows-release$env:PACKAGE_SUFFIX
